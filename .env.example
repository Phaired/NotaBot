# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=

# Application (client) id, used to register slash commands
DISCORD_CLIENT_ID=

# Snowflake id of the bot owner (used by owner-only commands)
OWNER_USER_ID=

# Default text-command prefix (per-guild prefix overrides this via the serverconfig module)
PREFIX=!

# Optional: register slash commands to a single guild for instant updates during development.
# Leave empty to register globally (can take up to 1h to propagate).
DEV_GUILD_ID=
